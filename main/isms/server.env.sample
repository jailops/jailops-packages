# isms configuration: plain KEY=VALUE, loaded natively by isms itself (ISMS_SERVER_ENV, set by the rc.d script).
# Installed mode 0600, owner isms: it holds secrets. Nothing in this file is generated for you:
# ISMS_SECRET is empty on purpose, and isms refuses to start until you set it (see the install message).
# Source of these settings and their meaning: the unidoc-aports package of isms (production). Full list: github.com/unidoc/isms/docs.

# --- Required: isms aborts at startup without these ---

# PostgreSQL connection.
DATABASE_URL="postgres://isms:CHANGEME@127.0.0.1:5432/isms?sslmode=disable"

# Public base URL (CORS, passkeys, notification links; also the production/dev-mode gate). isms aborts at
# startup if both this and ISMS_CORS_ORIGIN are empty, unless ISMS_DEV_MODE=1.
ISMS_BASE_URL=https://CHANGEME.example.com

# Master key (min 32 chars): JWT signing and, derived, the key that encrypts OIDC client secrets at rest.
# Set it ONCE, keep a backup; changing it logs everybody out and makes stored OIDC secrets unreadable.
#   sed -i '' "s|^ISMS_SECRET=.*|ISMS_SECRET=$(openssl rand -hex 32)|" /usr/local/etc/isms/server.env
# Restoring a backup onto a fresh install: put the OLD value here.
ISMS_SECRET=

# Per-org bare git repos live at $ISMS_DATA_DIR/repos/{slug}.git; with the "file" storage backend, branding and
# evidence blobs live here too. Owned by the isms user (the package creates it).
ISMS_DATA_DIR=/var/db/isms

# "file" keeps blobs under ISMS_DATA_DIR; "s3" needs the ISMS_S3_* variables below.
ISMS_STORAGE_BACKEND=file

# --- Template features (isms does not abort at startup without it, it fails when templates are listed) ---

# Standard templates repo on disk; this package ships none. Clone yours as the isms user, a FULL clone (never --bare):
#   su -m isms -c 'git clone <url> /var/db/isms/templates'
ISMS_TEMPLATE_PATH=/var/db/isms/templates

# --- SSH commit signing: optional for isms itself; every commit is signed as this identity when the key exists ---

# Create the key yourself, once (plain OpenSSH ed25519 private key, exactly what ssh-keygen writes):
#   su -m isms -c 'ssh-keygen -q -t ed25519 -N "" -C you@example.com -f /var/db/isms/private/isms_key'
ISMS_SIGNING_KEY=/var/db/isms/private/isms_key
ISMS_SIGNING_NAME=isms.sh
ISMS_SIGNING_EMAIL=CHANGEME@example.com

# --- Common ---
#ISMS_CORS_ORIGIN=https://isms.example.com
#ISMS_USER_SIGNUP=false

# S3/R2 backend (only when ISMS_STORAGE_BACKEND=s3):
#ISMS_S3_BUCKET=isms
#ISMS_S3_ENDPOINT=https://...
#ISMS_S3_ACCESS_KEY=...
#ISMS_S3_SECRET_KEY=...
